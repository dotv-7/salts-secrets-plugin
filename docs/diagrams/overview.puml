@startuml
!pragma layout smetana
skinparam handwritten true
skinparam defaultFontName "Patrick Hand"
skinparam defaultFontSize 16
skinparam shadowing true
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam rectangle {
  RoundCorner 6
  BorderColor #333333
}
skinparam database {
  BorderColor #333333
}
left to right direction

actor "You\n(your own DM)" as you
actor "Strangers\nTelegram · Discord\ngroups · web chat" as guest

rectangle "One Hermes · one gateway · one process · one API key" #FAFAF5 {
  rectangle "profile_routes\n--\nHermes' own routing\nyour user id -> owner\neveryone else -> public" as routes #EDEDED
  rectangle "Owner profile" #FFF3E0 {
    rectangle "Your agent\n--\nSOUL · MEMORY · USER\nworkspace · skills · sessions\nevery tool" as oagent #FFD9A0
    rectangle "Owner hook\n--\npost_gateway_admission\nnot your DM? the public\nprofile answers" as ohook #FFD9A0
    rectangle "Context page\n--\nrules then model: A / B / C\none owner click per item" as board #FFD9A0
    database "approvals.jsonl\nevery click" as log #FFE9C7
  }
  rectangle "Public profile" #EEF7E4 {
    rectangle "Guest hook\n--\nbots out · 20 an hour\nstale session -> fresh" as ghook #C8E6A0
    rectangle "Guest agent\n--\nits own SOUL\napproved notes only\nweb · vision · image · speech" as pagent #C8E6A0
    rectangle "Tool gate\n--\ndefault deny\nno local paths" as gate #C8E6A0
    rectangle "Reply check\n--\nrevoked mid-turn?\nnotice instead" as rcheck #C8E6A0
    database "Projection\napproved facts\nand documents" as proj #DCEFC4
    database "Guest state.db\nguest sessions only" as pdb #DCEFC4
  }
}

you --> routes
guest --> routes
routes --> oagent : your DM
routes --> ghook
routes ..> ohook : left in your profile\n(Discord server,\nunrouted platform)
ohook ..> pagent : /p/public/v1
ghook --> pagent
oagent ..> board : private sources
board --> proj : publish
board --> log
board --> pdb : revoke:\narchive + purge all
proj --> pagent
pagent -- gate
pagent --> rcheck
pagent --> pdb
@enduml
