@startuml
skinparam handwritten true
skinparam defaultFontName "Patrick Hand"
skinparam defaultFontSize 16
skinparam shadowing true
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBorderColor #333333
  ActorBorderColor #333333
}
skinparam note {
  BackgroundColor #FFF8C4
  BorderColor #333333
}
actor Stranger as S
participant "Gateway\nprofile_routes" as G #EDEDED
participant "Guest hook\n(public profile)" as H #C8E6A0
participant "Guest agent\n(public profile)" as P #C8E6A0
participant "Tool gate" as T #C8E6A0
participant "Your agent" as O #FFD9A0

S -> G : message in a group or DM
G -> G : not your user id:\nroute to the public profile
G -> H : pre_gateway_dispatch
H -> H : bots out,\nstale session -> fresh one
G -> H : post_gateway_admission
H -> H : 20 messages an hour
H -> P : the turn
P -> P : prompt = its own SOUL\n+ approved notes
P -> T : tool call (web, image...)
T --> P : allowed, or refused:\noff-list or a local path
P -> P : reply check (transform_llm_output):\nrevoked since the turn began?\nthen a short "ask again" notice
P --> G : reply
G --> S : reply
note over O : never sees the message.\nWhat routes cannot separate (your own\nmessage in a Discord server) is withheld\nby the owner hook and answered by the\npublic profile over /p/public/v1
@enduml
